// AeroOps — Aviation Academy Operating System
// Multi-tenant relational schema. Every operational record hangs off an
// Organization so a single deployment can serve many flight schools.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform administration (AeroOps staff — never members of customer orgs)
// ---------------------------------------------------------------------------

enum PlatformRole {
  FOUNDER
  SOFTWARE_ENGINEER
  PLATFORM_ADMIN
  CUSTOMER_SUCCESS
  SUPPORT_ENGINEER
  BILLING_ADMIN
  AUDITOR
}

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  role         PlatformRole
  isActive     Boolean      @default(true)
  mfaEnabled   Boolean      @default(false)
  mfaSecret    String?
  sessionVersion Int        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  auditLogs AuditLog[]
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String   @unique
  priceMonthly      Decimal  @default(0) @db.Decimal(8, 2)
  maxUsers          Int
  maxAircraft       Int
  maxLocations      Int
  storageGb         Int      @default(10)
  apiRequestsPerDay Int      @default(10000)
  supportTier       String   @default("Standard")
  /// Module keys available on this plan (see lib/features.ts MODULES)
  modules           String[]

  organizations Organization[]
}

/// Immutable trail of every important action, tenant and platform alike.
model AuditLog {
  id                  String   @id @default(cuid())
  organizationId      String?
  actorUserId         String?
  actorPlatformUserId String?
  actorLabel          String
  action              String
  entityType          String?
  entityId            String?
  oldValue            Json?
  newValue            Json?
  ip                  String?
  userAgent           String?
  createdAt           DateTime @default(now())

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorPlatformUser PlatformUser? @relation(fields: [actorPlatformUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  brandColor String  @default("#2563eb")
  timeZone  String   @default("America/New_York")
  status    OrgStatus @default(ACTIVE)
  /// Primary Owner (a User id). Transfer requires dual confirmation + audit.
  ownerId   String?
  planId    String?
  /// Module keys switched off for this org (overrides plan availability)
  disabledModules String[] @default([])
  /// Activated business activities (see lib/business-profiles.ts). Empty = all plan modules.
  businessProfiles String[] @default([])
  /// Built-in automation keys the org has switched off (see lib/automations.ts)
  disabledAutomations String[] @default([])
  /// Demo tenants are excluded from customer analytics and safe to delete.
  isDemo    Boolean  @default(false)
  suspendedAt DateTime?
  deletedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan           SubscriptionPlan? @relation(fields: [planId], references: [id])
  users          User[]
  locations      Location[]
  departments    Department[]
  orgRoles       OrgRole[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  aircraft       Aircraft[]
  lessonTypes    LessonType[]
  scheduleEvents ScheduleEvent[]
  invoices       Invoice[]
  notifications  Notification[]
  documents      Document[]
  syllabi        Syllabus[]
  snapshots      OrgSnapshot[]
  simulations    SimulationRun[]

  @@index([status])
}

/// Data-driven role: a named bundle of permission keys. System roles are
/// seeded per-org from the built-in defaults; organizations may add custom
/// roles freely. Permission keys are cataloged in lib/permissions.ts.
model OrgRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  invitations  Invitation[]

  @@unique([organizationId, name])
}

model Department {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(STUDENT)
  customRoleId   String?
  token          String    @unique
  invitedBy      String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   OrgRole?     @relation(fields: [customRoleId], references: [id])

  @@index([organizationId])
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  DISPATCHER
  INSTRUCTOR
  STUDENT
  MAINTENANCE
  ACCOUNTANT
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  /// Built-in role (drives default permissions). A customRole overrides it.
  role           Role
  customRoleId   String?
  primaryLocationId String?
  departmentId   String?
  isActive       Boolean  @default(true)
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?
  /// Incremented to invalidate every outstanding JWT ("log out all devices").
  sessionVersion Int      @default(0)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole        OrgRole?        @relation(fields: [customRoleId], references: [id])
  primaryLocation   Location?       @relation("PrimaryLocationUsers", fields: [primaryLocationId], references: [id])
  department        Department?     @relation(fields: [departmentId], references: [id])
  studentProfile    Student?
  instructorProfile Instructor?
  notifications     Notification[]
  documents         Document[]      @relation("DocumentOwner")

  @@index([organizationId, role])
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  icao           String? // e.g. KPAO
  iata           String?
  address        String?
  phone          String?
  email          String?
  operatingHours String? // e.g. "Mon–Sun 07:00–20:00"
  fuelProvider   String?
  weatherStation String? // METAR source, e.g. KPAO
  runwayNotes    String?
  patternNotes   String?
  emergencyNotes String?
  timeZone       String  @default("America/New_York")
  isActive       Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  primaryUsers   User[]          @relation("PrimaryLocationUsers")
  aircraft       Aircraft[]
  scheduleEvents ScheduleEvent[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum CertificateType {
  NONE
  STUDENT_PILOT
  SPORT
  RECREATIONAL
  PRIVATE
  INSTRUMENT
  COMMERCIAL
  CFI
  CFII
  MEI
  ATP
}

enum TrainingPart {
  PART_61
  PART_141
}

enum StudentStatus {
  LEAD
  DISCOVERY_FLIGHT
  PROSPECT
  ENROLLED
  GRADUATE
  ALUMNI
  INACTIVE
}

model Student {
  id                 String          @id @default(cuid())
  userId             String          @unique
  status             StudentStatus   @default(ENROLLED)
  leadSource         String? // walk-in, web, referral, airshow, ...
  discoveryFlightAt  DateTime?
  discoveryOutcome   String? // interested, not_interested, follow_up
  faaCertificateNumber String?
  ftnNumber          String?
  writtenTestPassed  Boolean?
  writtenTestScore   Int?
  writtenTestDate    DateTime?
  emergencyContact   String?
  emergencyPhone     String?
  certificateHeld    CertificateType @default(NONE)
  medicalClass       String?
  medicalExpiration  DateTime?
  studentCertNumber  String?
  tsaVerified        Boolean         @default(false)
  trainingGoal       String?
  trainingPart       TrainingPart    @default(PART_61)
  assignedInstructorId String?
  accountBalance     Decimal         @default(0) @db.Decimal(10, 2)
  totalHours         Decimal         @default(0) @db.Decimal(7, 1)
  soloHours          Decimal         @default(0) @db.Decimal(7, 1)
  enrolledAt         DateTime        @default(now())

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedInstructor Instructor?     @relation(fields: [assignedInstructorId], references: [id])
  enrollments        SyllabusEnrollment[]
  scheduleEvents     ScheduleEvent[]
  dispatches         Dispatch[]
  invoices           Invoice[]
  endorsements       Endorsement[]
  ratings            StudentRating[]
  checkrides         Checkride[]
  lessonRecords      LessonRecord[]
  lessonRequests     LessonRequest[]
  waitlistEntries    WaitlistEntry[]

  @@index([assignedInstructorId])
}

model Instructor {
  id              String   @id @default(cuid())
  userId          String   @unique
  certificates    String // comma list: CFI,CFII,MEI
  cfiNumber       String?
  cfiExpiration   DateTime?
  medicalExpiration DateTime?
  hourlyRate      Decimal  @default(65) @db.Decimal(8, 2)
  bio             String?
  hiredAt         DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students       Student[]
  scheduleEvents ScheduleEvent[]
  dispatches     Dispatch[]
  availability   InstructorAvailability[]
  endorsements   Endorsement[]
  lessonRecords  LessonRecord[]
  checkrides     Checkride[]
  lessonRequests LessonRequest[]
}

model InstructorAvailability {
  id           String   @id @default(cuid())
  instructorId String
  dayOfWeek    Int // 0 = Sunday
  startTime    String // "08:00"
  endTime      String // "17:00"

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

enum AircraftStatus {
  AVAILABLE
  IN_MAINTENANCE
  GROUNDED
  RESERVED
  RETIRED
}

enum OwnershipType {
  SCHOOL_OWNED
  LEASEBACK
  RENTAL
  PARTNER_OWNED
  PRIVATE_OWNER
}

model AircraftType {
  id           String  @id @default(cuid())
  manufacturer String
  model        String
  engineType   String  @default("Piston")
  seats        Int     @default(2)

  aircraft Aircraft[]

  @@unique([manufacturer, model])
}

model Aircraft {
  id                     String         @id @default(cuid())
  organizationId         String
  locationId             String?
  aircraftTypeId         String
  tailNumber             String         @unique
  nickname               String?
  serialNumber           String?
  year                   Int?
  ownershipType          OwnershipType  @default(SCHOOL_OWNED)
  ownerName              String?
  engineModel            String?
  engineSerial           String?
  propManufacturer       String?
  propSerial             String?
  emptyWeightLbs         Int?
  maxGrossWeightLbs      Int?
  fuelCapacityGal        Int?
  cruiseSpeedKts         Int?
  fuelSurchargePerHr     Decimal?       @db.Decimal(6, 2)
  insuranceCostMonthly   Decimal?       @db.Decimal(8, 2)
  /// Direct operating cost basis for profitability estimates.
  estimatedHourlyCost    Decimal?       @db.Decimal(8, 2)
  hourlyRateWet          Decimal        @db.Decimal(8, 2)
  hourlyRateDry          Decimal?       @db.Decimal(8, 2)
  fuelType               String         @default("100LL")
  usefulLoadLbs          Int?
  status                 AircraftStatus @default(AVAILABLE)
  currentHobbs           Decimal        @default(0) @db.Decimal(9, 1)
  currentTach            Decimal        @default(0) @db.Decimal(9, 1)
  engineTimeSmoh         Decimal        @default(0) @db.Decimal(9, 1)
  propTimeSpoh           Decimal        @default(0) @db.Decimal(9, 1)
  insuranceExpiration    DateTime?
  registrationExpiration DateTime?
  photoUrl               String?
  isSimulator            Boolean        @default(false)
  notes                  String?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?            @relation(fields: [locationId], references: [id])
  aircraftType   AircraftType         @relation(fields: [aircraftTypeId], references: [id])
  components     AircraftComponent[]
  squawks        Squawk[]
  maintenance    MaintenanceOrder[]
  scheduleEvents ScheduleEvent[]
  dispatches     Dispatch[]
  documents      Document[]           @relation("AircraftDocuments")

  @@index([organizationId, status])
}

// Inspection / life-limited item tracking (annual, 100hr, ELT, pitot-static,
// transponder, ADS-B, oil, tires, brakes, battery...). Either date-based,
// hours-based, or both.
model AircraftComponent {
  id            String    @id @default(cuid())
  aircraftId    String
  name          String
  dueAtHours    Decimal?  @db.Decimal(9, 1)
  dueAtDate     DateTime?
  lastDoneHours Decimal?  @db.Decimal(9, 1)
  lastDoneDate  DateTime?
  intervalHours Int?
  intervalMonths Int?
  notes         String?

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
}

enum SquawkStatus {
  OPEN
  ASSIGNED
  WAITING_PARTS
  IN_PROGRESS
  TESTING
  RESOLVED
  CLOSED
  DEFERRED
}

enum SquawkSeverity {
  GROUNDING
  MAJOR
  MINOR
}

model Squawk {
  id          String         @id @default(cuid())
  aircraftId  String
  reportedById String?
  title       String
  description String?
  category    String? // Airframe, Engine, Avionics, Interior, ...
  assignedTo  String?
  severity    SquawkSeverity @default(MINOR)
  status      SquawkStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  resolution  String?

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, status])
}

enum MaintenanceStatus {
  DRAFT
  OPEN
  SCHEDULED
  ASSIGNED
  WAITING_PARTS
  IN_PROGRESS
  AWAITING_INSPECTION
  APPROVED
  RETURN_TO_SERVICE
  COMPLETED
  CLOSED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
  AOG // aircraft on ground
  EMERGENCY
}

model MaintenanceOrder {
  id          String            @id @default(cuid())
  number      String? // WO-xxxx, assigned on open
  aircraftId  String
  title       String
  description String?
  category    String? // Engine, Avionics, Routine Inspection, ...
  priority    WorkOrderPriority @default(NORMAL)
  status      MaintenanceStatus @default(SCHEDULED)
  assignedTo  String?
  correctiveAction String?
  laborHours  Decimal?          @db.Decimal(6, 1)
  /// Return-to-service approval (electronic signature)
  approvedBy  String?
  approvedAt  DateTime?
  startDate   DateTime
  endDate     DateTime?
  estimatedCompletion DateTime?
  costParts   Decimal?          @db.Decimal(10, 2)
  costLabor   Decimal?          @db.Decimal(10, 2)
  loggedAt    DateTime          @default(now())

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, status])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum EventType {
  FLIGHT_LESSON
  SOLO_FLIGHT
  GROUND_LESSON
  SIMULATOR
  CHECKRIDE
  RENTAL
  MAINTENANCE_BLOCK
  MEETING
}

enum EventStatus {
  SCHEDULED
  DISPATCHED
  IN_FLIGHT
  COMPLETED
  CANCELLED
  NO_SHOW
  WEATHER_CANCELLED
}

model LessonType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  color          String  @default("#2563eb")
  durationMin    Int     @default(120)
  requiresAircraft Boolean @default(true)
  requiresInstructor Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  lessonRequests LessonRequest[]

  @@index([organizationId])
}

model ScheduleEvent {
  id             String      @id @default(cuid())
  organizationId String
  /// Groups occurrences of a recurring series.
  seriesId       String?
  locationId     String?
  type           EventType   @default(FLIGHT_LESSON)
  status         EventStatus @default(SCHEDULED)
  title          String?
  start          DateTime
  end            DateTime
  aircraftId     String?
  instructorId   String?
  studentId      String?
  lessonTypeId   String?
  syllabusLessonId String?
  notes          String?
  cancellationReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?      @relation(fields: [locationId], references: [id])
  aircraft       Aircraft?      @relation(fields: [aircraftId], references: [id])
  instructor     Instructor?    @relation(fields: [instructorId], references: [id])
  student        Student?       @relation(fields: [studentId], references: [id])
  lessonType     LessonType?    @relation(fields: [lessonTypeId], references: [id])
  syllabusLesson SyllabusLesson? @relation(fields: [syllabusLessonId], references: [id])
  dispatch       Dispatch?

  @@index([organizationId, start, end])
  @@index([seriesId])
  @@index([aircraftId, start])
  @@index([instructorId, start])
  @@index([studentId, start])
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

enum DispatchStatus {
  PENDING
  RELEASED
  CLOSED
  CANCELLED
}

model Dispatch {
  id              String         @id @default(cuid())
  scheduleEventId String         @unique
  aircraftId      String
  studentId       String?
  instructorId    String?
  status          DispatchStatus @default(PENDING)

  // Pre-flight release
  fuelQty         String?
  oilQty          String?
  weatherAcknowledged Boolean    @default(false)
  documentsVerified   Boolean    @default(false)
  instructorApproved  Boolean    @default(false)
  studentApproved     Boolean    @default(false)
  releasedAt      DateTime?
  releasedBy      String?

  // Post-flight closeout
  hobbsOut        Decimal?       @db.Decimal(9, 1)
  hobbsIn         Decimal?       @db.Decimal(9, 1)
  tachOut         Decimal?       @db.Decimal(9, 1)
  tachIn          Decimal?       @db.Decimal(9, 1)
  flightTime      Decimal?       @db.Decimal(6, 1)
  landings        Int?
  nightTime       Decimal?       @db.Decimal(6, 1)
  instrumentTime  Decimal?       @db.Decimal(6, 1)
  dualReceived    Decimal?       @db.Decimal(6, 1)
  dualGiven       Decimal?       @db.Decimal(6, 1)
  picTime         Decimal?       @db.Decimal(6, 1)
  fuelAddedGal    Decimal?       @db.Decimal(6, 1)
  closedAt        DateTime?

  scheduleEvent ScheduleEvent @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)
  aircraft      Aircraft      @relation(fields: [aircraftId], references: [id])
  student       Student?      @relation(fields: [studentId], references: [id])
  instructor    Instructor?   @relation(fields: [instructorId], references: [id])

  @@index([status])
}

// ---------------------------------------------------------------------------
// Training / syllabus
// ---------------------------------------------------------------------------

model Syllabus {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  trainingPart   TrainingPart @default(PART_61)
  description    String?
  requiredHours  Decimal      @default(40) @db.Decimal(6, 1)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       SyllabusStage[]
  enrollments  SyllabusEnrollment[]

  @@index([organizationId])
}

model SyllabusStage {
  id         String @id @default(cuid())
  syllabusId String
  name       String
  order      Int
  isStageCheck Boolean @default(false)

  syllabus Syllabus         @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  lessons  SyllabusLesson[]

  @@index([syllabusId])
}

model SyllabusLesson {
  id      String @id @default(cuid())
  stageId String
  name    String
  order   Int
  objective String?
  minHours  Decimal? @db.Decimal(5, 1)

  stage          SyllabusStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  lessonRecords  LessonRecord[]

  @@index([stageId])
}

model SyllabusEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  syllabusId String
  startedAt  DateTime @default(now())
  completedAt DateTime?

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  syllabus Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@unique([studentId, syllabusId])
}

enum LessonGrade {
  EXCELLENT
  SATISFACTORY
  NEEDS_IMPROVEMENT
  INCOMPLETE
}

model LessonRecord {
  id               String      @id @default(cuid())
  studentId        String
  instructorId     String
  syllabusLessonId String?
  date             DateTime    @default(now())
  grade            LessonGrade @default(SATISFACTORY)
  flightHours      Decimal?    @db.Decimal(5, 1)
  groundHours      Decimal?    @db.Decimal(5, 1)
  notes            String?
  signedByInstructor Boolean   @default(false)
  signedByStudent    Boolean   @default(false)

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor     Instructor      @relation(fields: [instructorId], references: [id])
  syllabusLesson SyllabusLesson? @relation(fields: [syllabusLessonId], references: [id])

  @@index([studentId, date])
}

model Endorsement {
  id           String   @id @default(cuid())
  studentId    String
  instructorId String
  title        String
  farReference String? // e.g. 61.87(b)
  text         String
  signedAt     DateTime @default(now())
  expiresAt    DateTime?

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id])

  @@index([studentId])
}

model StudentRating {
  id        String          @id @default(cuid())
  studentId String
  rating    CertificateType
  earnedAt  DateTime        @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum CheckrideStatus {
  SCHEDULED
  PASSED
  FAILED
  DISCONTINUED
  CANCELLED
}

model Checkride {
  id           String          @id @default(cuid())
  studentId    String
  instructorId String?
  rating       CertificateType
  examinerName String?
  date         DateTime
  status       CheckrideStatus @default(SCHEDULED)
  notes        String?

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@index([studentId, date])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  VOID
  OVERDUE
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String?
  number         String        @unique
  status         InvoiceStatus @default(OPEN)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  memo           String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?      @relation(fields: [studentId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([organizationId, status])
  @@index([studentId])
}

enum LineItemKind {
  AIRCRAFT_RENTAL
  INSTRUCTOR_TIME
  GROUND_INSTRUCTION
  SIMULATOR_TIME
  FUEL_SURCHARGE
  MEMBERSHIP_FEE
  LATE_FEE
  SUPPLY
  DISCOUNT
  OTHER
}

model InvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  kind        LineItemKind @default(OTHER)
  description String
  quantity    Decimal      @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  ACCOUNT_CREDIT
  GIFT_CERTIFICATE
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CARD)
  reference String? // Stripe payment intent id, check #, ...
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Notifications & documents
// ---------------------------------------------------------------------------

enum NotificationKind {
  UPCOMING_FLIGHT
  MAINTENANCE_DUE
  DOCUMENT_EXPIRING
  BALANCE_DUE
  SCHEDULE_CHANGE
  WEATHER_CANCELLATION
  AIRCRAFT_GROUNDED
  INSTRUCTOR_UNAVAILABLE
  SQUAWK_REPORTED
  GENERAL
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  kind           NotificationKind @default(GENERAL)
  title          String
  body           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, isRead])
}

enum DocumentKind {
  MEDICAL_CERTIFICATE
  PILOT_CERTIFICATE
  GOVERNMENT_ID
  INSURANCE
  RENTAL_AGREEMENT
  TRAINING_RECORD
  MAINTENANCE_LOG
  OTHER
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String?
  aircraftId     String?
  kind           DocumentKind @default(OTHER)
  name           String
  fileUrl        String
  expiresAt      DateTime?
  uploadedAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("DocumentOwner", fields: [ownerId], references: [id])
  aircraft     Aircraft?    @relation("AircraftDocuments", fields: [aircraftId], references: [id])

  @@index([organizationId, kind])
  @@index([ownerId])
}

/// Every sign-in attempt, successful or not — feeds the security dashboard.
model LoginEvent {
  id             String   @id @default(cuid())
  email          String
  userId         String?
  organizationId String?
  platformUserId String?
  success        Boolean
  reason         String? // bad_password, mfa_failed, ok, ...
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([email, createdAt])
}

enum LessonRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
  SCHEDULED
  CANCELLED
}

/// Student-initiated scheduling: request → staff review → booking.
model LessonRequest {
  id             String              @id @default(cuid())
  organizationId String
  studentId      String
  preferredStart DateTime
  durationMin    Int                 @default(120)
  lessonTypeId   String?
  instructorId   String?
  notes          String?
  status         LessonRequestStatus @default(PENDING)
  staffNote      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonType LessonType? @relation(fields: [lessonTypeId], references: [id])
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@index([organizationId, status])
}

/// Students waiting for an opening on a given day; notified on cancellations.
model WaitlistEntry {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  date           DateTime // the day they want to fly
  notes          String?
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY_SCHEDULED
  DISCOVERY_COMPLETED
  APPLICATION
  ENROLLED
  LOST
}

/// CRM lead — every prospective customer, from web form to enrollment.
model Lead {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  source         String     @default("website")
  interest       String? // Private Pilot, membership, rental...
  status         LeadStatus @default(NEW)
  estValue       Decimal?   @db.Decimal(10, 2)
  priority       Int        @default(3) // 1 high … 5 low
  assignedTo     String?
  notes          String?
  nextFollowUp   DateTime?
  convertedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, nextFollowUp])
}

/// Scoped service-account key for the public API (Bearer aero_...).
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// sha256 of the full key; the key itself is shown once at creation.
  keyHash        String    @unique
  prefix         String // first 12 chars, for identification
  scopes         String[] // permission keys from lib/permissions.ts
  readOnly       Boolean   @default(false)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
}

/// Outbound webhook subscription; deliveries are HMAC-signed with `secret`.
model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  events         String[] // e.g. flight.closed, aircraft.grounded, lead.created
  secret         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int?
  success    Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

/// Aviation inventory item (parts, consumables, tools).
model Part {
  id             String   @id @default(cuid())
  organizationId String
  partNumber     String
  manufacturer   String?
  description    String
  category       String   @default("Consumable") // Engine, Tires, Oil, Avionics...
  condition      String   @default("NEW")
  unitCost       Decimal? @db.Decimal(10, 2)
  quantity       Int      @default(0)
  minQuantity    Int      @default(0)
  maxQuantity    Int?
  location       String? // warehouse / bin / shelf
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([organizationId, partNumber])
  @@index([organizationId, category])
}

enum MovementType {
  RECEIVE
  TRANSFER
  INSTALL
  REMOVE
  RETURN
  SCRAP
  WARRANTY
  ADJUSTMENT
  LOST
  DAMAGED
  AUDIT
}

/// Every stock change, forever — the traceability ledger.
model InventoryMovement {
  id           String       @id @default(cuid())
  partId       String
  type         MovementType
  quantity     Int // signed: receives positive, installs negative
  workOrderId  String?
  aircraftId   String?
  notes        String?
  performedBy  String?
  createdAt    DateTime     @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId, createdAt])
}

/// Saved Mission Control scene: an ordered set of widget panels an
/// organization curates for a specific operational purpose (Section 16B).
model MissionControlScene {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  panels         String[] // ordered widget keys, validated at the API
  createdBy      String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Internal platform-staff note on a customer organization (Section 19).
/// Never visible to the customer — rendered only in the Founder Platform.
model PlatformNote {
  id             String   @id @default(cuid())
  organizationId String
  authorLabel    String
  body           String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Founder tooling: snapshots & live simulation
// ---------------------------------------------------------------------------

/// Point-in-time capture of an organization's operational dataset (JSON, row
/// IDs preserved) so a known-good demo environment can be restored on demand.
model OrgSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  data           Json
  sizeBytes      Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum SimulationStatus {
  RUNNING
  STOPPED
}

/// A live simulation session driven from the Founder Platform. Each tick
/// writes realistic operational activity into the target organization.
model SimulationRun {
  id             String           @id @default(cuid())
  organizationId String
  scenario       String // morning-rush, busy-weekend, weather-event, ...
  status         SimulationStatus @default(RUNNING)
  startedBy      String
  startedAt      DateTime         @default(now())
  stoppedAt      DateTime?
  tickCount      Int              @default(0)
  eventsCreated  Int              @default(0)
  lastTickAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}
