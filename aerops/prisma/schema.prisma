  signedByStudent    Boolean     @default(false)

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor     Instructor      @relation(fields: [instructorId], references: [id])
  syllabusLesson SyllabusLesson? @relation(fields: [syllabusLessonId], references: [id])

  @@index([studentId, date])
}

model Endorsement {
  id           String    @id @default(cuid())
  studentId    String
  instructorId String
  title        String
  farReference String? // e.g. 61.87(b)
  text         String
  signedAt     DateTime  @default(now())
  expiresAt    DateTime?

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id])

  @@index([studentId])
}

model StudentRating {
  id        String          @id @default(cuid())
  studentId String
  rating    CertificateType
  earnedAt  DateTime        @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum CheckrideStatus {
  SCHEDULED
  PASSED
  FAILED
  DISCONTINUED
  CANCELLED
}

model Checkride {
  id           String          @id @default(cuid())
  studentId    String
  instructorId String?
  rating       CertificateType
  examinerName String?
  date         DateTime
  status       CheckrideStatus @default(SCHEDULED)
  notes        String?

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@index([studentId, date])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  VOID
  OVERDUE
  // Revenue Engine (M1) — added additively; existing values keep their meaning.
  // For review-wrapped invoices these project from RevenueReviewStatus (doc 03);
  // standalone/legacy invoices are unaffected.
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String?
  number         String
  status         InvoiceStatus @default(OPEN)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  memo           String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?      @relation(fields: [studentId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  revenueReview RevenueReview?

  // Revenue Engine — Phase 5 (M10). scheduledCharge is 1:1 (invoiceId @unique);
  // platformFees/disputes/paymentAttempts/allocations are 1:many (FK not unique).
  allocations     RevenueAllocation[]
  platformFees    PlatformFee[]
  disputes        Dispute[]
  scheduledCharge ScheduledCharge?
  paymentAttempts PaymentAttempt[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([studentId])
}

enum LineItemKind {
  AIRCRAFT_RENTAL
  INSTRUCTOR_TIME
  GROUND_INSTRUCTION
  SIMULATOR_TIME
  FUEL_SURCHARGE
  MEMBERSHIP_FEE
  LATE_FEE
  SUPPLY
  DISCOUNT
  OTHER
}

model InvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  kind        LineItemKind @default(OTHER)
  description String
  quantity    Decimal      @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  ACCOUNT_CREDIT
  GIFT_CERTIFICATE
}

model Payment {
  id        String        @id @default(cuid())
  /// NEW (Phase 5) — direct org scope for reporting/reconciliation (R19);
  /// nullable, backfilled from invoice.organizationId, tightened later.
  organizationId String?
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  /// NEW (Phase 5) — ISO 4217; non-null with "USD" default.
  currency  String        @default("USD") @db.Char(3)
  method    PaymentMethod @default(CARD)
  reference String? // Stripe payment intent id, check #, ...
  /// NEW (Phase 5) — exactly one Payment per successful attempt (§7).
  paymentAttemptId String? @unique
  paidAt    DateTime      @default(now())

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// CHANGED (Phase 5): Cascade → Restrict. A settled-money record must never
  /// cascade-delete with its invoice (00's landmine). Metadata-only ALTER;
  /// tenant wipe deletes payments before invoices (§10).
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  attempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  refunds  Refund[]
  disputes Dispute[]

  @@index([invoiceId])
  @@index([organizationId, paidAt]) // NEW — org/date payment reporting
}

// ---------------------------------------------------------------------------
// Notifications & documents
// ---------------------------------------------------------------------------

enum NotificationKind {
  UPCOMING_FLIGHT
  MAINTENANCE_DUE
  DOCUMENT_EXPIRING
  BALANCE_DUE
  SCHEDULE_CHANGE
  WEATHER_CANCELLATION
  AIRCRAFT_GROUNDED
  INSTRUCTOR_UNAVAILABLE
  SQUAWK_REPORTED
  GENERAL
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  kind           NotificationKind @default(GENERAL)
  title          String
  body           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, isRead])
}

enum DocumentKind {
  MEDICAL_CERTIFICATE
  PILOT_CERTIFICATE
  GOVERNMENT_ID
  INSURANCE
  RENTAL_AGREEMENT
  TRAINING_RECORD
  MAINTENANCE_LOG
  OTHER
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String?
  aircraftId     String?
  kind           DocumentKind @default(OTHER)
  name           String
  fileUrl        String
  expiresAt      DateTime?
  uploadedAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("DocumentOwner", fields: [ownerId], references: [id])
  aircraft     Aircraft?    @relation("AircraftDocuments", fields: [aircraftId], references: [id])

  payerConsentRelationships StudentPayerRelationship[] @relation("PayerConsentDocuments")

  @@index([organizationId, kind])
  @@index([ownerId])
}

/// Every sign-in attempt, successful or not — feeds the security dashboard.
model LoginEvent {
  id             String   @id @default(cuid())
  email          String
  userId         String?
  organizationId String?
  platformUserId String?
  success        Boolean
  reason         String? // bad_password, mfa_failed, ok, ...
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([email, createdAt])
}

enum LessonRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
  SCHEDULED
  CANCELLED
}

/// Student-initiated scheduling: request → staff review → booking.
model LessonRequest {
  id             String              @id @default(cuid())
  organizationId String
  studentId      String
  preferredStart DateTime
  durationMin    Int                 @default(120)
  lessonTypeId   String?
  instructorId   String?
  notes          String?
  status         LessonRequestStatus @default(PENDING)
  staffNote      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonType LessonType? @relation(fields: [lessonTypeId], references: [id])
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

/// Students waiting for an opening on a given day; notified on cancellations.
model WaitlistEntry {
  id             String    @id @default(cuid())
  organizationId String
  studentId      String
  date           DateTime // the day they want to fly
  notes          String?
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY_SCHEDULED
  DISCOVERY_COMPLETED
  APPLICATION
  ENROLLED
  LOST
}

/// CRM lead — every prospective customer, from web form to enrollment.
model Lead {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  source         String     @default("website")
  interest       String? // Private Pilot, membership, rental...
  status         LeadStatus @default(NEW)
  estValue       Decimal?   @db.Decimal(10, 2)
  priority       Int        @default(3) // 1 high … 5 low
  assignedTo     String?
  notes          String?
  nextFollowUp   DateTime?
  convertedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, nextFollowUp])
}

/// Scoped service-account key for the public API (Bearer aero_...).
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// sha256 of the full key; the key itself is shown once at creation.
  keyHash        String    @unique
  prefix         String // first 12 chars, for identification
  scopes         String[] // permission keys from lib/permissions.ts
  readOnly       Boolean   @default(false)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Outbound webhook subscription; deliveries are HMAC-signed with `secret`.
model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  events         String[] // e.g. flight.closed, aircraft.grounded, lead.created
  secret         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  deliveries WebhookDelivery[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int?
  success    Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

/// Aviation inventory item (parts, consumables, tools).
model Part {
  id             String    @id @default(cuid())
  organizationId String
  partNumber     String
  manufacturer   String?
  description    String
  category       String    @default("Consumable") // Engine, Tires, Oil, Avionics...
  condition      String    @default("NEW")
  unitCost       Decimal?  @db.Decimal(10, 2)
  quantity       Int       @default(0)
  minQuantity    Int       @default(0)
  maxQuantity    Int?
  location       String? // warehouse / bin / shelf
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  movements InventoryMovement[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, partNumber])
  @@index([organizationId, category])
}

enum MovementType {
  RECEIVE
  TRANSFER
  INSTALL
  REMOVE
  RETURN
  SCRAP
  WARRANTY
  ADJUSTMENT
  LOST
  DAMAGED
  AUDIT
}

/// Every stock change, forever — the traceability ledger.
model InventoryMovement {
  id          String       @id @default(cuid())
  partId      String
  type        MovementType
  quantity    Int // signed: receives positive, installs negative
  workOrderId String?
  aircraftId  String?
  notes       String?
  performedBy String?
  createdAt   DateTime     @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId, createdAt])
}

/// Saved Mission Control scene: an ordered set of widget panels an
/// organization curates for a specific operational purpose (Section 16B).
model MissionControlScene {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  panels         String[] // ordered widget keys, validated at the API
  createdBy      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Internal platform-staff note on a customer organization (Section 19).
/// Never visible to the customer — rendered only in the Founder Platform.
model PlatformNote {
  id             String   @id @default(cuid())
  organizationId String
  authorLabel    String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Founder tooling: snapshots & live simulation
// ---------------------------------------------------------------------------

/// Point-in-time capture of an organization's operational dataset (JSON, row
/// IDs preserved) so a known-good demo environment can be restored on demand.
model OrgSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  data           Json
  sizeBytes      Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum SimulationStatus {
  RUNNING
  STOPPED
}

/// A live simulation session driven from the Founder Platform. Each tick
/// writes realistic operational activity into the target organization.
model SimulationRun {
  id             String           @id @default(cuid())
  organizationId String
  scenario       String // morning-rush, busy-weekend, weather-event, ...
  status         SimulationStatus @default(RUNNING)
  startedBy      String
  startedAt      DateTime         @default(now())
  stoppedAt      DateTime?
  tickCount      Int              @default(0)
  eventsCreated  Int              @default(0)
  lastTickAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Public onboarding: join requests, invite links, demo requests
// ---------------------------------------------------------------------------

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO
  CANCELLED
}

/// An individual account asking to become a member of an organization.
/// Approval assigns the role/location and attaches the user to the org.
model JoinRequest {
  id                 String            @id @default(cuid())
  organizationId     String
  userId             String
  requestedRole      Role              @default(STUDENT)
  phone              String?
  certificateInfo    String? // pilot certificate / student status, free text
  reason             String?
  message            String?
  status             JoinRequestStatus @default(PENDING)
  /// Internal note, never shown to the requester.
  adminNote          String?
  /// Response shown to the requester (rejection reason / info request).
  adminResponse      String?
  assignedRole       Role?
  assignedLocationId String?
  decidedByLabel     String?
  decidedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId, status])
}

/// Shareable invite link (distinct from per-email Invitation): anyone with
/// the URL can join (auto-approve) or file a pre-filled join request.
model InviteLink {
  id             String    @id @default(cuid())
  organizationId String
  /// sha256 of the shareable link token; the raw token is shown once at
  /// creation and never stored (lib/tokens.ts, ADR-020).
  tokenHash      String    @unique
  label          String    @default("General invite")
  role           Role      @default(STUDENT)
  autoApprove    Boolean   @default(false)
  maxUses        Int?
  uses           Int       @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Demo/contact requests from the public marketing site (no tenant scope).
model DemoRequest {
  id        String   @id @default(cuid())
  kind      String   @default("demo") // demo | contact
  name      String
  email     String
  company   String?
  phone     String?
  orgType   String?
  fleetSize String?
  message   String?
  status    String   @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Import Center
// ---------------------------------------------------------------------------

enum ImportJobStatus {
  COMMITTED
  ROLLED_BACK
  ROLLBACK_PARTIAL
}

/// A committed data import: who ran it, what was mapped, what happened to
/// every row, and which records it created (for rollback). Mappings are
/// remembered per (organization, source, data type) by reusing the latest
/// job's mapping.
model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  createdByLabel String
  createdById    String?
  source         String // flight-circle | flight-schedule-pro | flightlogger | aviatize | quickbooks | stripe | csv | excel | paste
  dataType       String // students | aircraft | invoices | ...
  fileName       String?
  status         ImportJobStatus @default(COMMITTED)
  mapping        Json // { targetField: sourceColumn }
  options        Json? // duplicate strategy, etc.
  totals         Json? // { total, created, updated, skipped, failed }
  rowErrors      Json? // [{ row, message }]
  /// IDs of records CREATED by this job, per model — the rollback manifest.
  createdRecords Json?
  rolledBackAt   DateTime?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ===========================================================================
// Revenue Engine — Phase 1 (M2): per-org configuration singletons + catalogs
// Additive, tenant-scoped, typed columns (never a settings JSON). Absent row =
// code defaults (zero-setup). See docs/architecture/revenue-engine/13 §4.
// ===========================================================================

/// Monotonic per-org sequence source for human-facing numbers (invoice,
/// revenue_review, adjustment). Engine-cataloged keys.
model OrgSequence {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  nextValue      Int      @default(1)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

/// One row per org; absent row = code defaults. Approval-workflow configuration
/// only — typed columns (doc 03 + R15).
model RevenueWorkflowPolicy {
  id                            String   @id @default(cuid())
  organizationId                String   @unique
  instructorSubmissionRequired  Boolean  @default(true)
  instructorMayApproveRoutine   Boolean  @default(false)
  routineApprovalMaxAmount      Decimal? @db.Decimal(12, 2)
  operationsApprovalRequired    Boolean  @default(true)
  secondApprovalAmountThreshold Decimal? @db.Decimal(12, 2)
  secondApprovalForManualItems  Boolean  @default(false)
  secondApprovalForDamageFees   Boolean  @default(true)
  secondApprovalForRefunds      Boolean  @default(true)
  financeApprovalRequired       Boolean  @default(false)
  separationOfDutiesRequired    Boolean  @default(true)
  instructorSeesOwnCompensation Boolean  @default(false)
  // Single discount second-approval mechanism (docs 03/08 aligned) — threshold
  // pair, no separate boolean toggle.
  discountSecondApprovalPercent   Decimal @default(10.00) @db.Decimal(5, 2)
  discountSecondApprovalAmount    Decimal @default(250.00) @db.Decimal(12, 2)
  damageFeeWaiverSecondApproval   Boolean @default(true)
  creditIssueSecondApprovalAmount Decimal @default(500.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum WarningMode {
  OFF
  WARN
  BLOCK
}

/// Per-org operational capture/validation config (doc 02); one optional row.
model DispatchPolicy {
