// NOTE: enum RevenueLineOrigin (PRICING/INSTRUCTOR_TIME/RULE/RETURN_CAPTURE/
// MANUAL/ADJUSTMENT) is NOT added in Phase 2 — its first writer is InvoiceLine.origin
// (Phase 3 M11). Add it then. TaxTreatment above uses INHERIT to represent the
// "null = inherit" fields (columns are nullable; INHERIT is available for
// explicit selection).

// --- M4: Aircraft pricing profiles (doc 05) ---
model AircraftPricingProfile {
  id             String        @id @default(cuid())
  organizationId String
  aircraftId     String?
  locationId     String?
  familyId       String
  version        Int           @default(1)
  name           String
  description    String?
  status         ProfileStatus @default(DRAFT)
  isDefault      Boolean       @default(false)
  priority       Int           @default(100)

  billingBasis        PricingBillingBasis @default(HOBBS)
  customUnitLabel     String?
  wetDry              WetDryDesignation   @default(WET)
  rateAmount          Decimal             @db.Decimal(12, 2)
  currency            String              @default("USD") @db.Char(3)
  minBillableQuantity Decimal?            @db.Decimal(6, 2)
  roundingRule        PricingRoundingRule @default(NEAREST_TENTH)
  taxTreatment        TaxTreatment?
  includedFeeItemIds  String[]            @default([])

  eligibleMembershipRoles String[] @default([])
  eligibleCustomerTypes   String[] @default([])
  eligibleProgramIds      String[] @default([])

  effectiveStart DateTime
  effectiveEnd   DateTime?

  createdById     String
  createdByLabel  String
  approvedById    String?
  approvedByLabel String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft     Aircraft?    @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  dispatches Dispatch[]
  // TRIMMED (Phase 3 M11): invoiceLines InvoiceLine[]

  @@unique([organizationId, familyId, version])
  @@index([organizationId, status])
  @@index([organizationId, aircraftId, effectiveStart])
  @@index([organizationId, effectiveStart])
}

// --- M4: Instructor rate profiles (billing vs compensation, doc 04) ---
model InstructorRateProfile {
