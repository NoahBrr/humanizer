model SyllabusStage {
  id           String  @id @default(cuid())
  syllabusId   String
  name         String
  order        Int
  isStageCheck Boolean @default(false)

  syllabus Syllabus         @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  lessons  SyllabusLesson[]

  @@index([syllabusId])
}

model SyllabusLesson {
  id        String   @id @default(cuid())
  stageId   String
  name      String
  order     Int
  objective String?
  minHours  Decimal? @db.Decimal(5, 1)

  stage          SyllabusStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  lessonRecords  LessonRecord[]

  @@index([stageId])
