// AeroOps — Aviation Academy Operating System
// Multi-tenant relational schema. Every operational record hangs off an
// Organization so a single deployment can serve many flight schools.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform administration (AeroOps staff — never members of customer orgs)
// ---------------------------------------------------------------------------

enum PlatformRole {
  /// Highest platform authority (D3-A). Held only by the bootstrapped founders.
  FOUNDER_SUPER_ADMIN
  FOUNDER
  SOFTWARE_ENGINEER
  PLATFORM_ADMIN
  CUSTOMER_SUCCESS
  SUPPORT_ENGINEER
  BILLING_ADMIN
  AUDITOR
}

model PlatformUser {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               PlatformRole
  /// Optional custom platform role — a named bundle of platform permissions
  /// that overrides the built-in role's defaults when set (mirrors OrgRole).
  customRoleId       String?
  /// Immutable founder identity — set ONLY by the founder bootstrap, never by
  /// role assignment (ADR-024). Founder-only console access keys on this, so
  /// founder power cannot be granted by editing a role in the UI.
  isFounder          Boolean      @default(false)
  isActive           Boolean      @default(true)
  /// Forces a secure password rotation before the account is usable (bootstrap).
  mustChangePassword Boolean      @default(false)
  mfaEnabled         Boolean      @default(false)
  mfaSecret          String?
  sessionVersion     Int          @default(0)
  /// Time-boxed access: a session outside [accessStartsAt, accessExpiresAt] is
  /// refused, giving temporary/expiring platform access.
  accessStartsAt     DateTime?
  accessExpiresAt    DateTime?
  /// Read-only scope — refused all mutations (like read-only impersonation).
  readOnly           Boolean      @default(false)
  /// If non-empty, this platform user may only act on these organization ids.
  restrictedOrgIds   String[]     @default([])
  invitedByLabel     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  customRole            PlatformCustomRole?    @relation(fields: [customRoleId], references: [id])
  auditLogs             AuditLog[]
  impersonationSessions ImpersonationSession[]

  @@index([customRoleId])
}

/// A named, custom bundle of platform permissions (D3-A). Mirrors OrgRole for
/// customer orgs: a platform user holds a built-in PlatformRole or a custom role
/// that overrides it. Permission keys come from lib/platform-permissions.ts.
model PlatformCustomRole {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  permissions    String[]
  createdByLabel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  platformUsers PlatformUser[]
  invitations   PlatformUserInvitation[]
}

/// A pending invitation for a new Platform User (D3-A). Only the token hash is
/// stored; the raw setup token is shown once. Accepting it creates the account
/// with a password the invitee sets — a founder never handles another user's
/// password.
model PlatformUserInvitation {
  id             String       @id @default(cuid())
  email          String
  firstName      String
  lastName       String
  role           PlatformRole
  customRoleId   String?
  /// sha256 of the single-use setup token (lib/tokens.ts, ADR-020).
  tokenHash      String       @unique
  invitedByLabel String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customRole PlatformCustomRole? @relation(fields: [customRoleId], references: [id])

  @@index([email])
  @@index([customRoleId])
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String   @unique
  priceMonthly      Decimal  @default(0) @db.Decimal(8, 2)
  maxUsers          Int
  maxAircraft       Int
  maxLocations      Int
  storageGb         Int      @default(10)
  apiRequestsPerDay Int      @default(10000)
  supportTier       String   @default("Standard")
  /// Module keys available on this plan (see lib/features.ts MODULES)
  modules           String[]

  organizations       Organization[]
  platformFeePolicies PlatformFeePolicy[]
}

/// Immutable trail of every important action, tenant and platform alike.
///
/// Attribution (ADR-023): `actorUserId` is a genuine customer actor;
/// `actorPlatformUserId` is a genuine AeroOps-staff actor. During impersonation
/// BOTH identities are preserved separately — the staff member is the real
/// actor (`actorPlatformUserId`), the customer they represent is
/// `impersonatedUserId`, and `impersonationSessionId` links the support session.
/// A row must never imply a customer independently performed a staff-initiated
/// action, so under impersonation `actorUserId` is left null.
/// Note: `actorUserId` is a bare string (no FK) because API-key service
/// accounts record `apikey:<id>`, which is not a User row.
model AuditLog {
  id                     String   @id @default(cuid())
  organizationId         String?
  actorUserId            String?
  actorPlatformUserId    String?
  impersonatedUserId     String?
  impersonationSessionId String?
  actorLabel             String
  action                 String
  entityType             String?
  entityId               String?
  oldValue               Json?
  newValue               Json?
  ip                     String?
  userAgent              String?
  createdAt              DateTime @default(now())

  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorPlatformUser    PlatformUser?         @relation(fields: [actorPlatformUserId], references: [id])
  impersonatedUser     User?                 @relation("ImpersonatedAudits", fields: [impersonatedUserId], references: [id], onDelete: SetNull)
  impersonationSession ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([impersonatedUserId, createdAt])
  @@index([impersonationSessionId])
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Regulatory / operational category of a customer organization (Phase D2).
enum OrgType {
  PART_61_FLIGHT_SCHOOL
  PART_141_FLIGHT_SCHOOL
  FLYING_CLUB
  UNIVERSITY_PROGRAM
  CORPORATE_FLIGHT_DEPT
  MAINTENANCE_ORG
  OTHER
}

/// Commercial state of the subscription. Distinct from OrgStatus (access) and
/// from live billing — MANUAL means invoiced off-platform (no Stripe).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  MANUAL
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  LIVE
}

/// How the org is billed. STRIPE is provisioned behind an env flag and is never
/// live in this phase (PRODUCTION.md); MANUAL is the safe default.
enum BillingMode {
  MANUAL
  STRIPE
}

model Organization {
  id                  String             @id @default(cuid())
  /// Public display name (shown to customers and in the workspace).
  name                String
  /// Registered legal entity name, if different from the display name.
  legalName           String?
  slug                String             @unique
  orgType             OrgType            @default(OTHER)
  description         String?
  website             String?
  phone               String?
  billingEmail        String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  /// Org mailing/contact address (free text); per-site addresses live on Location.
  address             String?
  logoUrl             String?
  /// Storage-adapter object key for the logo (lib/storage). Served via logoUrl.
  logoObjectKey       String?
  brandColor          String             @default("#2563eb")
  timeZone            String             @default("America/New_York")
  status              OrgStatus          @default(ACTIVE)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  onboardingStatus    OnboardingStatus   @default(NOT_STARTED)
  billingMode         BillingMode        @default(MANUAL)
  /// Whether the org appears in public organization search (self-serve join).
  isDiscoverable      Boolean            @default(false)
  /// Per-org capacity overrides; null falls back to the plan's limit. These are
  /// subscription limits, NOT live counts (Section D2 Part 3).
  maxAircraftOverride Int?
  maxUsersOverride    Int?
  /// Primary Owner (a User id). Source of truth for ownership; the referenced
  /// user must hold an active ACCOUNT_OWNER Membership (ADR-023). Transfer runs
  /// through the dedicated ownership-transfer service (ownerId + memberships,
  /// atomically) — never a plain profile update.
  ownerId             String?
  planId              String?
  /// Module keys switched off for this org (overrides plan availability)
  disabledModules     String[]           @default([])
  /// Activated business activities (see lib/business-profiles.ts). Empty = all plan modules.
  businessProfiles    String[]           @default([])
  /// Built-in automation keys the org has switched off (see lib/automations.ts)
  disabledAutomations String[]           @default([])
  /// Demo tenants are excluded from customer analytics and safe to delete.
  isDemo              Boolean            @default(false)
  /// Internal platform-staff notes (never customer-visible) live in PlatformNote.
  suspendedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  plan                  SubscriptionPlan?      @relation(fields: [planId], references: [id])
  users                 User[]
  memberships           Membership[]
  locations             Location[]
  departments           Department[]
  orgRoles              OrgRole[]
  invitations           Invitation[]
  auditLogs             AuditLog[]
  impersonationSessions ImpersonationSession[]
  aircraft              Aircraft[]
  lessonTypes           LessonType[]
  scheduleEvents        ScheduleEvent[]
  invoices              Invoice[]
  notifications         Notification[]
  documents             Document[]
  syllabi               Syllabus[]
  snapshots             OrgSnapshot[]
  simulations           SimulationRun[]
  joinRequests          JoinRequest[]
  inviteLinks           InviteLink[]
  importJobs            ImportJob[]
  loginEvents           LoginEvent[]
  lessonRequests        LessonRequest[]
  waitlistEntries       WaitlistEntry[]
  leads                 Lead[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  parts                 Part[]
  missionControlScenes  MissionControlScene[]
  platformNotes         PlatformNote[]
  // Revenue Engine config singletons + catalogs (M2)
  orgSequences                OrgSequence[]
  revenueWorkflowPolicy       RevenueWorkflowPolicy?
  dispatchPolicy              DispatchPolicy?
  checkoutRestrictionPolicies CheckoutRestrictionPolicy[]
  orgPaymentPolicy            OrgPaymentPolicy?
  accountingMappings          AccountingMapping[]
  revenueSettings             RevenueSettings?
  // Revenue Engine — Phase 2 (M3–M7)
  aircraftPricingProfiles      AircraftPricingProfile[]
  instructorRateProfiles       InstructorRateProfile[]
  revenueItems                 RevenueItem[]
  taxRules                     TaxRule[]
  responsiblePayers            ResponsiblePayer[]
  studentPayerRelationships    StudentPayerRelationship[]
  dispatchRestrictionDecisions DispatchRestrictionDecision[]
  dispatches                   Dispatch[]
  // Revenue Engine — Phase 3 (M9)
  revenueReviews          RevenueReview[]
  revenueReviewApprovals  RevenueReviewApproval[]
  instructorTimeEntries   InstructorTimeEntry[]

  // Revenue Engine — Phase 4 (M8)
  paymentCustomers         PaymentCustomer[]
  paymentMethodReferences  PaymentMethodReference[]
  paymentConsents          PaymentConsent[]

  // Revenue Engine — Phase 5 (M10): payment execution + financial ledger
  payments                 Payment[]
  instructorEarnings       InstructorEarning[]
  refunds                  Refund[]
  disputes                 Dispute[]
  scheduledCharges         ScheduledCharge[]
  paymentAttempts          PaymentAttempt[]
  paymentProviderEvents    PaymentProviderEvent[]
  revenueAllocations       RevenueAllocation[]
  platformFeePolicies      PlatformFeePolicy[]
  platformFees             PlatformFee[]
  ledgerEntries            LedgerEntry[]
  providerPayouts          ProviderPayout[]
  reconciliationExceptions ReconciliationException[]
  connectedAccount         ConnectedAccount?
  financialHolds           FinancialHold[]

  @@index([status])
  @@index([orgType])
}

/// Data-driven role: a named bundle of permission keys. System roles are
/// seeded per-org from the built-in defaults; organizations may add custom
/// roles freely. Permission keys are cataloged in lib/permissions.ts.
model OrgRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, name])
}

model Department {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String?
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])
  users        User[]
  memberships  Membership[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(STUDENT)
  customRoleId   String?
  /// sha256 of the single-use invite token; the raw token is emailed/shown
  /// once and never stored (lib/tokens.ts, ADR-020).
  tokenHash      String    @unique
  invitedBy      String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   OrgRole?     @relation(fields: [customRoleId], references: [id])

  @@index([organizationId])
}

/// Organization-level roles. `ACCOUNT_OWNER` is the ultimate authority within
/// one organization (the user referenced by `Organization.ownerId`).
/// `SUPER_ADMIN` is DEPRECATED as an organization role (ADR-023): it was
/// historically conflated with ownership. It is retained in the enum only to
/// avoid a destructive Postgres enum-value drop; the D2 migration moves every
/// customer row off it and no code assigns it (enforced by
/// tests/schema-governance). `SCHOOL_ADMIN` is a broad Organization
/// Administrator, explicitly NOT a synonym for ownership.
enum Role {
  ACCOUNT_OWNER
  SUPER_ADMIN
  SCHOOL_ADMIN
  DISPATCHER
  INSTRUCTOR
  STUDENT
  MAINTENANCE
  ACCOUNTANT
}

/// Status of a user's membership in one organization.
enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

/// A user's affiliation with one organization: their role there, status, and
/// primary location/department (ADR-023). This is the source of truth for org
/// affiliation and roles and supports one user belonging to many organizations.
/// `User.organizationId`/`role`/`customRoleId`/`primaryLocationId`/`departmentId`
/// are a maintained projection of the user's ACTIVE (session-selected) membership
/// so the operational core stays single-org-scoped from the session.
model Membership {
  id                String           @id @default(cuid())
  userId            String
  organizationId    String
  role              Role
  /// Custom OrgRole override (wins over the built-in role), same-org only.
  customRoleId      String?
  primaryLocationId String?
  departmentId      String?
  status            MembershipStatus @default(ACTIVE)
  /// Label of who created/invited this membership (audit-friendly, never a
  /// cross-tenant FK).
  invitedByLabel    String?
  approvedByLabel   String?
  deactivatedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole      OrgRole?     @relation(fields: [customRoleId], references: [id])
  primaryLocation Location?    @relation("MembershipPrimaryLocation", fields: [primaryLocationId], references: [id])
  department      Department?  @relation(fields: [departmentId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([organizationId, role])
}

/// A live, audited support session in which AeroOps staff act as a customer
/// user (ADR-023 / Priority 1). The signed impersonation cookie carries this
/// row's id; every audit written while it is active links back here, preserving
/// both identities. Expiry (`expiresAt`) stops impersonated access and
/// attribution; `endedAt` records an explicit stop.
model ImpersonationSession {
  id             String    @id @default(cuid())
  platformUserId String
  targetUserId   String
  organizationId String
  reason         String
  readOnly       Boolean   @default(true)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])
  targetUser   User         @relation("ImpersonatedSessions", fields: [targetUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([platformUserId, startedAt])
  @@index([organizationId, startedAt])
  @@index([targetUserId])
}

model User {
  id                String    @id @default(cuid())
  /// Null = individual account not yet part of any organization (public
  /// sign-up). Joining or creating an organization sets it.
  organizationId    String?
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  /// Built-in role (drives default permissions). A customRole overrides it.
  role              Role
  customRoleId      String?
  primaryLocationId String?
  departmentId      String?
  isActive          Boolean   @default(true)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  /// Incremented to invalidate every outstanding JWT ("log out all devices").
  sessionVersion    Int       @default(0)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole           OrgRole?               @relation(fields: [customRoleId], references: [id])
  primaryLocation      Location?              @relation("PrimaryLocationUsers", fields: [primaryLocationId], references: [id])
  department           Department?            @relation(fields: [departmentId], references: [id])
  memberships          Membership[]
  studentProfile       Student?
  instructorProfile    Instructor?
  notifications        Notification[]
  documents            Document[]             @relation("DocumentOwner")
  joinRequests         JoinRequest[]
  impersonatedSessions ImpersonationSession[] @relation("ImpersonatedSessions")
  impersonatedAudits   AuditLog[]             @relation("ImpersonatedAudits")

  responsiblePayers    ResponsiblePayer[]
  revenueReviewApprovals RevenueReviewApproval[]

  @@index([organizationId, role])
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  icao           String? // e.g. KPAO
  iata           String?
  address        String?
  phone          String?
  email          String?
  operatingHours String? // e.g. "Mon–Sun 07:00–20:00"
  fuelProvider   String?
  weatherStation String? // METAR source, e.g. KPAO
  runwayNotes    String?
  patternNotes   String?
  emergencyNotes String?
  timeZone       String  @default("America/New_York")
  isActive       Boolean @default(true)

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments        Department[]
  primaryUsers       User[]          @relation("PrimaryLocationUsers")
  primaryMemberships Membership[]    @relation("MembershipPrimaryLocation")
  aircraft           Aircraft[]
  scheduleEvents     ScheduleEvent[]

  aircraftPricingProfiles AircraftPricingProfile[]
  instructorRateProfiles  InstructorRateProfile[]
  revenueItemLocations    RevenueItemLocation[]
  taxRules                TaxRule[]
  dispatches              Dispatch[]
  revenueReviews          RevenueReview[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum CertificateType {
  NONE
  STUDENT_PILOT
  SPORT
  RECREATIONAL
  PRIVATE
  INSTRUMENT
  COMMERCIAL
  CFI
  CFII
  MEI
  ATP
}

enum TrainingPart {
  PART_61
  PART_141
}

enum StudentStatus {
  LEAD
  DISCOVERY_FLIGHT
  PROSPECT
  ENROLLED
  GRADUATE
  ALUMNI
  INACTIVE
}

model Student {
  id                   String          @id @default(cuid())
  userId               String          @unique
  status               StudentStatus   @default(ENROLLED)
  leadSource           String? // walk-in, web, referral, airshow, ...
  discoveryFlightAt    DateTime?
  discoveryOutcome     String? // interested, not_interested, follow_up
  faaCertificateNumber String?
  ftnNumber            String?
  writtenTestPassed    Boolean?
  writtenTestScore     Int?
  writtenTestDate      DateTime?
  emergencyContact     String?
  emergencyPhone       String?
  certificateHeld      CertificateType @default(NONE)
  medicalClass         String?
  medicalExpiration    DateTime?
  studentCertNumber    String?
  tsaVerified          Boolean         @default(false)
  trainingGoal         String?
  trainingPart         TrainingPart    @default(PART_61)
  assignedInstructorId String?
  accountBalance       Decimal         @default(0) @db.Decimal(10, 2)
  totalHours           Decimal         @default(0) @db.Decimal(7, 1)
  soloHours            Decimal         @default(0) @db.Decimal(7, 1)
  enrolledAt           DateTime        @default(now())

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedInstructor Instructor?          @relation(fields: [assignedInstructorId], references: [id])
  enrollments        SyllabusEnrollment[]
  scheduleEvents     ScheduleEvent[]
  dispatches         Dispatch[]
  invoices           Invoice[]
  endorsements       Endorsement[]
  ratings            StudentRating[]
  checkrides         Checkride[]
  lessonRecords      LessonRecord[]
  lessonRequests     LessonRequest[]
  waitlistEntries    WaitlistEntry[]

  studentPayerRelationships StudentPayerRelationship[]
  revenueReviews            RevenueReview[]
  paymentCustomers          PaymentCustomer[]
  financialHolds            FinancialHold[]

  @@index([assignedInstructorId])
}

model Instructor {
  id                String    @id @default(cuid())
  userId            String    @unique
  certificates      String // comma list: CFI,CFII,MEI
  cfiNumber         String?
  cfiExpiration     DateTime?
  medicalExpiration DateTime?
  hourlyRate        Decimal   @default(65) @db.Decimal(8, 2)
  bio               String?
  hiredAt           DateTime  @default(now())

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students       Student[]
  scheduleEvents ScheduleEvent[]
  dispatches     Dispatch[]
  availability   InstructorAvailability[]
  endorsements   Endorsement[]
  lessonRecords  LessonRecord[]
  checkrides     Checkride[]
  lessonRequests LessonRequest[]

  instructorRateProfiles InstructorRateProfile[]
  revenueReviews         RevenueReview[]
  instructorTimeEntries  InstructorTimeEntry[]
  earnings               InstructorEarning[]
}

model InstructorAvailability {
  id           String @id @default(cuid())
  instructorId String
  dayOfWeek    Int // 0 = Sunday
  startTime    String // "08:00"
  endTime      String // "17:00"

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

enum AircraftStatus {
  AVAILABLE
  IN_MAINTENANCE
  GROUNDED
  RESERVED
  RETIRED
}

enum OwnershipType {
  SCHOOL_OWNED
  LEASEBACK
  RENTAL
  PARTNER_OWNED
  PRIVATE_OWNER
}

model AircraftType {
  id           String @id @default(cuid())
  manufacturer String
  model        String
  engineType   String @default("Piston")
  seats        Int    @default(2)

  aircraft Aircraft[]

  @@unique([manufacturer, model])
}

model Aircraft {
  id                     String         @id @default(cuid())
  organizationId         String
  locationId             String?
  aircraftTypeId         String
  tailNumber             String
  nickname               String?
  serialNumber           String?
  year                   Int?
  ownershipType          OwnershipType  @default(SCHOOL_OWNED)
  ownerName              String?
  engineModel            String?
  engineSerial           String?
  propManufacturer       String?
  propSerial             String?
  emptyWeightLbs         Int?
  maxGrossWeightLbs      Int?
  fuelCapacityGal        Int?
  cruiseSpeedKts         Int?
  fuelSurchargePerHr     Decimal?       @db.Decimal(6, 2)
  insuranceCostMonthly   Decimal?       @db.Decimal(8, 2)
  /// Direct operating cost basis for profitability estimates.
  estimatedHourlyCost    Decimal?       @db.Decimal(8, 2)
  hourlyRateWet          Decimal        @db.Decimal(8, 2)
  hourlyRateDry          Decimal?       @db.Decimal(8, 2)
  fuelType               String         @default("100LL")
  usefulLoadLbs          Int?
  status                 AircraftStatus @default(AVAILABLE)
  currentHobbs           Decimal        @default(0) @db.Decimal(9, 1)
  currentTach            Decimal        @default(0) @db.Decimal(9, 1)
  engineTimeSmoh         Decimal        @default(0) @db.Decimal(9, 1)
  propTimeSpoh           Decimal        @default(0) @db.Decimal(9, 1)
  insuranceExpiration    DateTime?
  registrationExpiration DateTime?
  photoUrl               String?
  isSimulator            Boolean        @default(false)
  notes                  String?

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?           @relation(fields: [locationId], references: [id])
  aircraftType   AircraftType        @relation(fields: [aircraftTypeId], references: [id])
  components     AircraftComponent[]
  squawks        Squawk[]
  maintenance    MaintenanceOrder[]
  scheduleEvents ScheduleEvent[]
  dispatches     Dispatch[]
  documents      Document[]          @relation("AircraftDocuments")

  aircraftPricingProfiles AircraftPricingProfile[]
  revenueItemAircraft     RevenueItemAircraft[]
  revenueReviews          RevenueReview[]

  createdAt DateTime @default(now())

  @@unique([organizationId, tailNumber])
  @@index([organizationId, status])
}

// Inspection / life-limited item tracking (annual, 100hr, ELT, pitot-static,
// transponder, ADS-B, oil, tires, brakes, battery...). Either date-based,
// hours-based, or both.
model AircraftComponent {
