enum EventType {
  FLIGHT_LESSON
  SOLO_FLIGHT
  GROUND_LESSON
  SIMULATOR
  CHECKRIDE
  RENTAL
  MAINTENANCE_BLOCK
  MEETING
}

enum EventStatus {
  SCHEDULED
  DISPATCHED
  IN_FLIGHT
  COMPLETED
  CANCELLED
  NO_SHOW
  WEATHER_CANCELLED
}

model LessonType {
  id                 String  @id @default(cuid())
  organizationId     String
  name               String
  color              String  @default("#2563eb")
  durationMin        Int     @default(120)
  requiresAircraft   Boolean @default(true)
  requiresInstructor Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  lessonRequests LessonRequest[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model ScheduleEvent {
  id                 String      @id @default(cuid())
  organizationId     String
  /// Groups occurrences of a recurring series.
  seriesId           String?
  locationId         String?
  type               EventType   @default(FLIGHT_LESSON)
  status             EventStatus @default(SCHEDULED)
  title              String?
  start              DateTime
  end                DateTime
  aircraftId         String?
  instructorId       String?
  studentId          String?
  lessonTypeId       String?
  syllabusLessonId   String?
  notes              String?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?       @relation(fields: [locationId], references: [id])
  aircraft       Aircraft?       @relation(fields: [aircraftId], references: [id])
  instructor     Instructor?     @relation(fields: [instructorId], references: [id])
  student        Student?        @relation(fields: [studentId], references: [id])
  lessonType     LessonType?     @relation(fields: [lessonTypeId], references: [id])
  syllabusLesson SyllabusLesson? @relation(fields: [syllabusLessonId], references: [id])
