// AeroOps — Aviation Academy Operating System
// Multi-tenant relational schema. Every operational record hangs off an
// Organization so a single deployment can serve many flight schools.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  brandColor String  @default("#2563eb")
  timeZone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  locations      Location[]
  aircraft       Aircraft[]
  lessonTypes    LessonType[]
  scheduleEvents ScheduleEvent[]
  invoices       Invoice[]
  notifications  Notification[]
  documents      Document[]
  syllabi        Syllabus[]
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  DISPATCHER
  INSTRUCTOR
  STUDENT
  MAINTENANCE
  ACCOUNTANT
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  role           Role
  isActive       Boolean  @default(true)
  mfaEnabled     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentProfile    Student?
  instructorProfile Instructor?
  notifications     Notification[]
  documents         Document[]      @relation("DocumentOwner")

  @@index([organizationId, role])
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  icao           String? // e.g. KPAO
  address        String?
  timeZone       String  @default("America/New_York")
  isActive       Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft[]
  scheduleEvents ScheduleEvent[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum CertificateType {
  NONE
  STUDENT_PILOT
  SPORT
  RECREATIONAL
  PRIVATE
  INSTRUMENT
  COMMERCIAL
  CFI
  CFII
  MEI
  ATP
}

enum TrainingPart {
  PART_61
  PART_141
}

model Student {
  id                 String          @id @default(cuid())
  userId             String          @unique
  emergencyContact   String?
  emergencyPhone     String?
  certificateHeld    CertificateType @default(NONE)
  medicalClass       String?
  medicalExpiration  DateTime?
  studentCertNumber  String?
  tsaVerified        Boolean         @default(false)
  trainingGoal       String?
  trainingPart       TrainingPart    @default(PART_61)
  assignedInstructorId String?
  accountBalance     Decimal         @default(0) @db.Decimal(10, 2)
  totalHours         Decimal         @default(0) @db.Decimal(7, 1)
  soloHours          Decimal         @default(0) @db.Decimal(7, 1)
  enrolledAt         DateTime        @default(now())

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedInstructor Instructor?     @relation(fields: [assignedInstructorId], references: [id])
  enrollments        SyllabusEnrollment[]
  scheduleEvents     ScheduleEvent[]
  dispatches         Dispatch[]
  invoices           Invoice[]
  endorsements       Endorsement[]
  ratings            StudentRating[]
  checkrides         Checkride[]
  lessonRecords      LessonRecord[]

  @@index([assignedInstructorId])
}

model Instructor {
  id              String   @id @default(cuid())
  userId          String   @unique
  certificates    String // comma list: CFI,CFII,MEI
  cfiNumber       String?
  cfiExpiration   DateTime?
  medicalExpiration DateTime?
  hourlyRate      Decimal  @default(65) @db.Decimal(8, 2)
  bio             String?
  hiredAt         DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students       Student[]
  scheduleEvents ScheduleEvent[]
  dispatches     Dispatch[]
  availability   InstructorAvailability[]
  endorsements   Endorsement[]
  lessonRecords  LessonRecord[]
  checkrides     Checkride[]
}

model InstructorAvailability {
  id           String   @id @default(cuid())
  instructorId String
  dayOfWeek    Int // 0 = Sunday
  startTime    String // "08:00"
  endTime      String // "17:00"

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

enum AircraftStatus {
  AVAILABLE
  IN_MAINTENANCE
  GROUNDED
  RESERVED
  RETIRED
}

model AircraftType {
  id           String  @id @default(cuid())
  manufacturer String
  model        String
  engineType   String  @default("Piston")
  seats        Int     @default(2)

  aircraft Aircraft[]

  @@unique([manufacturer, model])
}

model Aircraft {
  id                     String         @id @default(cuid())
  organizationId         String
  locationId             String?
  aircraftTypeId         String
  tailNumber             String         @unique
  year                   Int?
  hourlyRateWet          Decimal        @db.Decimal(8, 2)
  hourlyRateDry          Decimal?       @db.Decimal(8, 2)
  fuelType               String         @default("100LL")
  usefulLoadLbs          Int?
  status                 AircraftStatus @default(AVAILABLE)
  currentHobbs           Decimal        @default(0) @db.Decimal(9, 1)
  currentTach            Decimal        @default(0) @db.Decimal(9, 1)
  engineTimeSmoh         Decimal        @default(0) @db.Decimal(9, 1)
  propTimeSpoh           Decimal        @default(0) @db.Decimal(9, 1)
  insuranceExpiration    DateTime?
  registrationExpiration DateTime?
  photoUrl               String?
  isSimulator            Boolean        @default(false)
  notes                  String?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?            @relation(fields: [locationId], references: [id])
  aircraftType   AircraftType         @relation(fields: [aircraftTypeId], references: [id])
  components     AircraftComponent[]
  squawks        Squawk[]
  maintenance    MaintenanceOrder[]
  scheduleEvents ScheduleEvent[]
  dispatches     Dispatch[]
  documents      Document[]           @relation("AircraftDocuments")

  @@index([organizationId, status])
}

// Inspection / life-limited item tracking (annual, 100hr, ELT, pitot-static,
// transponder, ADS-B, oil, tires, brakes, battery...). Either date-based,
// hours-based, or both.
model AircraftComponent {
  id            String    @id @default(cuid())
  aircraftId    String
  name          String
  dueAtHours    Decimal?  @db.Decimal(9, 1)
  dueAtDate     DateTime?
  lastDoneHours Decimal?  @db.Decimal(9, 1)
  lastDoneDate  DateTime?
  intervalHours Int?
  intervalMonths Int?
  notes         String?

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
}

enum SquawkStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DEFERRED
}

enum SquawkSeverity {
  GROUNDING
  MAJOR
  MINOR
}

model Squawk {
  id          String         @id @default(cuid())
  aircraftId  String
  reportedById String?
  title       String
  description String?
  severity    SquawkSeverity @default(MINOR)
  status      SquawkStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  resolution  String?

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, status])
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceOrder {
  id          String            @id @default(cuid())
  aircraftId  String
  title       String
  description String?
  status      MaintenanceStatus @default(SCHEDULED)
  assignedTo  String?
  startDate   DateTime
  endDate     DateTime?
  costParts   Decimal?          @db.Decimal(10, 2)
  costLabor   Decimal?          @db.Decimal(10, 2)
  loggedAt    DateTime          @default(now())

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, status])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum EventType {
  FLIGHT_LESSON
  SOLO_FLIGHT
  GROUND_LESSON
  SIMULATOR
  CHECKRIDE
  RENTAL
  MAINTENANCE_BLOCK
  MEETING
}

enum EventStatus {
  SCHEDULED
  DISPATCHED
  IN_FLIGHT
  COMPLETED
  CANCELLED
  NO_SHOW
  WEATHER_CANCELLED
}

model LessonType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  color          String  @default("#2563eb")
  durationMin    Int     @default(120)
  requiresAircraft Boolean @default(true)
  requiresInstructor Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]

  @@index([organizationId])
}

model ScheduleEvent {
  id             String      @id @default(cuid())
  organizationId String
  locationId     String?
  type           EventType   @default(FLIGHT_LESSON)
  status         EventStatus @default(SCHEDULED)
  title          String?
  start          DateTime
  end            DateTime
  aircraftId     String?
  instructorId   String?
  studentId      String?
  lessonTypeId   String?
  syllabusLessonId String?
  notes          String?
  cancellationReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?      @relation(fields: [locationId], references: [id])
  aircraft       Aircraft?      @relation(fields: [aircraftId], references: [id])
  instructor     Instructor?    @relation(fields: [instructorId], references: [id])
  student        Student?       @relation(fields: [studentId], references: [id])
  lessonType     LessonType?    @relation(fields: [lessonTypeId], references: [id])
  syllabusLesson SyllabusLesson? @relation(fields: [syllabusLessonId], references: [id])
  dispatch       Dispatch?

  @@index([organizationId, start, end])
  @@index([aircraftId, start])
  @@index([instructorId, start])
  @@index([studentId, start])
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

enum DispatchStatus {
  PENDING
  RELEASED
  CLOSED
  CANCELLED
}

model Dispatch {
  id              String         @id @default(cuid())
  scheduleEventId String         @unique
  aircraftId      String
  studentId       String?
  instructorId    String?
  status          DispatchStatus @default(PENDING)

  // Pre-flight release
  fuelQty         String?
  oilQty          String?
  weatherAcknowledged Boolean    @default(false)
  documentsVerified   Boolean    @default(false)
  instructorApproved  Boolean    @default(false)
  studentApproved     Boolean    @default(false)
  releasedAt      DateTime?
  releasedBy      String?

  // Post-flight closeout
  hobbsOut        Decimal?       @db.Decimal(9, 1)
  hobbsIn         Decimal?       @db.Decimal(9, 1)
  tachOut         Decimal?       @db.Decimal(9, 1)
  tachIn          Decimal?       @db.Decimal(9, 1)
  flightTime      Decimal?       @db.Decimal(6, 1)
  landings        Int?
  nightTime       Decimal?       @db.Decimal(6, 1)
  instrumentTime  Decimal?       @db.Decimal(6, 1)
  dualReceived    Decimal?       @db.Decimal(6, 1)
  dualGiven       Decimal?       @db.Decimal(6, 1)
  picTime         Decimal?       @db.Decimal(6, 1)
  fuelAddedGal    Decimal?       @db.Decimal(6, 1)
  closedAt        DateTime?

  scheduleEvent ScheduleEvent @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)
  aircraft      Aircraft      @relation(fields: [aircraftId], references: [id])
  student       Student?      @relation(fields: [studentId], references: [id])
  instructor    Instructor?   @relation(fields: [instructorId], references: [id])

  @@index([status])
}

// ---------------------------------------------------------------------------
// Training / syllabus
// ---------------------------------------------------------------------------

model Syllabus {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  trainingPart   TrainingPart @default(PART_61)
  description    String?
  requiredHours  Decimal      @default(40) @db.Decimal(6, 1)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       SyllabusStage[]
  enrollments  SyllabusEnrollment[]

  @@index([organizationId])
}

model SyllabusStage {
  id         String @id @default(cuid())
  syllabusId String
  name       String
  order      Int
  isStageCheck Boolean @default(false)

  syllabus Syllabus         @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  lessons  SyllabusLesson[]

  @@index([syllabusId])
}

model SyllabusLesson {
  id      String @id @default(cuid())
  stageId String
  name    String
  order   Int
  objective String?
  minHours  Decimal? @db.Decimal(5, 1)

  stage          SyllabusStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  lessonRecords  LessonRecord[]

  @@index([stageId])
}

model SyllabusEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  syllabusId String
  startedAt  DateTime @default(now())
  completedAt DateTime?

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  syllabus Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@unique([studentId, syllabusId])
}

enum LessonGrade {
  EXCELLENT
  SATISFACTORY
  NEEDS_IMPROVEMENT
  INCOMPLETE
}

model LessonRecord {
  id               String      @id @default(cuid())
  studentId        String
  instructorId     String
  syllabusLessonId String?
  date             DateTime    @default(now())
  grade            LessonGrade @default(SATISFACTORY)
  flightHours      Decimal?    @db.Decimal(5, 1)
  groundHours      Decimal?    @db.Decimal(5, 1)
  notes            String?
  signedByInstructor Boolean   @default(false)
  signedByStudent    Boolean   @default(false)

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor     Instructor      @relation(fields: [instructorId], references: [id])
  syllabusLesson SyllabusLesson? @relation(fields: [syllabusLessonId], references: [id])

  @@index([studentId, date])
}

model Endorsement {
  id           String   @id @default(cuid())
  studentId    String
  instructorId String
  title        String
  farReference String? // e.g. 61.87(b)
  text         String
  signedAt     DateTime @default(now())
  expiresAt    DateTime?

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id])

  @@index([studentId])
}

model StudentRating {
  id        String          @id @default(cuid())
  studentId String
  rating    CertificateType
  earnedAt  DateTime        @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum CheckrideStatus {
  SCHEDULED
  PASSED
  FAILED
  DISCONTINUED
  CANCELLED
}

model Checkride {
  id           String          @id @default(cuid())
  studentId    String
  instructorId String?
  rating       CertificateType
  examinerName String?
  date         DateTime
  status       CheckrideStatus @default(SCHEDULED)
  notes        String?

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@index([studentId, date])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  VOID
  OVERDUE
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String?
  number         String        @unique
  status         InvoiceStatus @default(OPEN)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  memo           String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?      @relation(fields: [studentId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([organizationId, status])
  @@index([studentId])
}

enum LineItemKind {
  AIRCRAFT_RENTAL
  INSTRUCTOR_TIME
  GROUND_INSTRUCTION
  SIMULATOR_TIME
  FUEL_SURCHARGE
  MEMBERSHIP_FEE
  LATE_FEE
  SUPPLY
  DISCOUNT
  OTHER
}

model InvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  kind        LineItemKind @default(OTHER)
  description String
  quantity    Decimal      @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  ACCOUNT_CREDIT
  GIFT_CERTIFICATE
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CARD)
  reference String? // Stripe payment intent id, check #, ...
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Notifications & documents
// ---------------------------------------------------------------------------

enum NotificationKind {
  UPCOMING_FLIGHT
  MAINTENANCE_DUE
  DOCUMENT_EXPIRING
  BALANCE_DUE
  SCHEDULE_CHANGE
  WEATHER_CANCELLATION
  AIRCRAFT_GROUNDED
  INSTRUCTOR_UNAVAILABLE
  SQUAWK_REPORTED
  GENERAL
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  kind           NotificationKind @default(GENERAL)
  title          String
  body           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, isRead])
}

enum DocumentKind {
  MEDICAL_CERTIFICATE
  PILOT_CERTIFICATE
  GOVERNMENT_ID
  INSURANCE
  RENTAL_AGREEMENT
  TRAINING_RECORD
  MAINTENANCE_LOG
  OTHER
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String?
  aircraftId     String?
  kind           DocumentKind @default(OTHER)
  name           String
  fileUrl        String
  expiresAt      DateTime?
  uploadedAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("DocumentOwner", fields: [ownerId], references: [id])
  aircraft     Aircraft?    @relation("AircraftDocuments", fields: [aircraftId], references: [id])

  @@index([organizationId, kind])
  @@index([ownerId])
}
