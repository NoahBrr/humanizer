enum LessonGrade {
  EXCELLENT
  SATISFACTORY
  NEEDS_IMPROVEMENT
  INCOMPLETE
}

model LessonRecord {
  id                 String      @id @default(cuid())
  studentId          String
  instructorId       String
  syllabusLessonId   String?
  date               DateTime    @default(now())
  grade              LessonGrade @default(SATISFACTORY)
  flightHours        Decimal?    @db.Decimal(5, 1)
  groundHours        Decimal?    @db.Decimal(5, 1)
  notes              String?
