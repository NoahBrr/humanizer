enum MaintenanceStatus {
  DRAFT
  OPEN
  SCHEDULED
  ASSIGNED
  WAITING_PARTS
  IN_PROGRESS
  AWAITING_INSPECTION
  APPROVED
  RETURN_TO_SERVICE
  COMPLETED
  CLOSED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
  AOG // aircraft on ground
  EMERGENCY
}

model MaintenanceOrder {
  id                  String            @id @default(cuid())
  number              String? // WO-xxxx, assigned on open
  aircraftId          String
  title               String
  description         String?
  category            String? // Engine, Avionics, Routine Inspection, ...
