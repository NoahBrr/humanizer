# --- Local development configuration ----------------------------------------
# Copy to .env. These values are for LOCAL DEVELOPMENT ONLY.

DATABASE_URL="postgresql://aerops:aerops@localhost:5432/aerops"

# AUTH_SECRET signs session JWTs and the impersonation cookie.
#   Development: this placeholder works (if unset entirely, a documented
#     dev-only fallback in src/lib/env.ts is used).
#   Production:  startup FAILS unless AUTH_SECRET is set to a real secret —
#     this placeholder and short values are rejected (src/lib/env.ts).
#     Generate one:  openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-9f8a7b6c5d4e3f2a1b0c"

AUTH_TRUST_HOST=true

# The full production environment-variable matrix lives in PRODUCTION.md §16.
