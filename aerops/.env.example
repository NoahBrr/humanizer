# --- AeroOps local development configuration --------------------------------
# Copy this file to `.env` and fill in local values:  cp .env.example .env
#
# NEVER commit `.env` — `.gitignore` already excludes it (`.env*` with an
# exception only for this example). Do NOT put real secrets in THIS file; it is
# committed. Real secrets live only in your local `.env` or the deployment host.
# The full production environment-variable matrix is in PRODUCTION.md §16.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection. This local default matches the seed script and the
# `postgresql://aerops:aerops@localhost:5432/aerops` dev database.
DATABASE_URL="postgresql://aerops:aerops@localhost:5432/aerops"

# Signs session JWTs and the impersonation cookie.
#   Development: this placeholder works (a documented dev-only fallback in
#     src/lib/env.ts also applies if it is unset entirely).
#   Production:  startup FAILS unless set to a real secret — this placeholder
#     and short values are rejected (src/lib/env.ts, fail-closed).
#     Generate one:  openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-9f8a7b6c5d4e3f2a1b0c"

# Let NextAuth trust the local host in development.
AUTH_TRUST_HOST=true

# ── Optional integrations (leave unset for local dev) ───────────────────────
# The app degrades gracefully when these are absent — nothing here is needed to
# run, seed, or develop locally. Set real values only in your local `.env`.

# OAuth sign-in. Unset = email + password only (the demo logins work).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# AI insight narration (Anthropic). Unset = the deterministic insight engine
# (with reasons + confidence) still works; only live LLM narration is disabled.
# ANTHROPIC_API_KEY=""

# ── Dev tooling (screenshot / portal-verification scripts only) ─────────────
# Defaults are sensible; override only if your setup differs.
# CAPTURE_BASE="http://localhost:3100"
# CAPTURE_CHROMIUM="/path/to/chromium"
# PORTAL_BASE="http://localhost:3100"
# PORTAL_EMAIL="admin@aerops.demo"
# PORTAL_PASSWORD="demo1234"
